#include <string>
#include <cmath>
#include <vector>

class Solution {
private:
    bool isLeapYear(int year) {
        return (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0);
    }
    int daysFrom1900(const std::string& date) {
        int year = std::stoi(date.substr(0, 4));
        int month = std::stoi(date.substr(5, 2));
        int day = std::stoi(date.substr(8, 2));

        int days = 0
        for (int y = 1900; y < year; ++y) {
            days += isLeapYear(y) ? 366 : 365;
        }

        std::vector<int> daysInMonths = {0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
        if (isLeapYear(year)) {
            daysInMonths[2] = 29;
        }

        for (int m = 1; m < month; ++m) {
            days += daysInMonths[m];
        }

        days += day;

        return days;
    }

public:
    int daysBetweenDates(std::string date1, std::string date2) {
        return std::abs(daysFrom1900(date1) - daysFrom1900(date2));
    }
};
