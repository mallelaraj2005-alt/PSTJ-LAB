class Solution {
    public int[] shuffle(int[] nums, int n) {
    
        for (int i = 0; i < n; i++) {
            nums[i + n] = (nums[i] << 10) | nums[i + n];
        }
        
        for (int i = 0; i < n; i++) {
            int x = nums[i + n] >> 10;
            int y = nums[i + n] & 1023; // 1023 = (1 << 10) - 1
            
            nums[2 * i] = x;
            nums[2 * i + 1] = y;
        }
        
        return nums;
    }
}
